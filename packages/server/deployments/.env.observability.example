# Cove Agent LLM 监测（OpenTelemetry → Langfuse）环境变量示例。
# 复制需要的行到你的 API 运行环境。默认 OTEL_ENABLED=false，不设置则无遥测。

# 总开关
OTEL_ENABLED=true
OTEL_SERVICE_NAME=cove-api

# Trace 导出（Langfuse OTLP/HTTP；注意 Langfuse 不支持 gRPC）
# AUTH=$(echo -n "pk-lf-xxxx:sk-lf-xxxx" | base64)
OTEL_TRACES_ENDPOINT=http://localhost:3000/api/public/otel/v1/traces
OTEL_TRACES_HEADERS=Authorization=Basic <base64(pk:sk)>

# 采样率 0..1（默认 1）
OTEL_SAMPLE_RATIO=1

# 可选：指标导出到 OTLP 指标后端（Langfuse 不摄取指标，留空即用 noop）
# OTEL_METRICS_ENDPOINT=http://otel-collector:4318/v1/metrics
# OTEL_METRICS_HEADERS=

# 本地明文 HTTP 时可置 true（跳过 TLS）
# OTEL_INSECURE=true
