{
  "name": "retrieval",
  "cases": [
    {
      "id": "q-vector",
      "query": "什么是向量数据库",
      "tags": ["knowledge"],
      "expect": {
        "relevant_ids": ["doc-vec", "doc-embed"],
        "match_on": "doc",
        "k": 5,
        "recall_min": 1.0,
        "hit_min": 1.0,
        "mrr_min": 0.5,
        "ndcg_min": 0.8
      }
    },
    {
      "id": "q-rerank",
      "query": "重排序如何工作",
      "tags": ["knowledge"],
      "expect": {
        "relevant_ids": ["doc-rerank"],
        "match_on": "doc",
        "k": 5,
        "recall_min": 1.0,
        "hit_min": 1.0
      }
    }
  ]
}
